# ===========================================
# LOCAL DEVELOPMENT
# ===========================================
DATABASE_URL="file:./dev.db"

# ===========================================
# PRODUCTION (Turso - free at turso.tech)
# ===========================================
# 1. Sign up at https://turso.tech
# 2. turso db create dey-took-r-jarbs
# 3. turso db show dey-took-r-jarbs --url   → TURSO_DATABASE_URL
# 4. turso db tokens create dey-took-r-jarbs → TURSO_AUTH_TOKEN
# 5. Deploy to Vercel, then hit POST /api/setup with {"secret":"your-cron-secret"} to create tables
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# ===========================================
# RAPIDAPI (required for job search)
# ===========================================
# 1. Sign up at https://rapidapi.com
# 2. Subscribe to JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 3. Copy your API key from the dashboard
RAPIDAPI_KEY="your-rapidapi-key"

# ===========================================
# ANTHROPIC (required for AI features)
# ===========================================
ANTHROPIC_API_KEY="sk-ant-..."

# ===========================================
# GMAIL NOTIFICATIONS (optional)
# ===========================================
# Use a Google App Password: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
NOTIFICATION_EMAIL="your-email@gmail.com"

# ===========================================
# CLERK (required for authentication)
# ===========================================
# 1. Sign up at https://clerk.com
# 2. Create a new application
# 3. Copy keys from the API Keys page in your Clerk Dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
CLERK_SECRET_KEY="YOUR_SECRET_KEY"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# ===========================================
# SECURITY
# ===========================================
CRON_SECRET="generate-a-random-secret-here"

# ===========================================
# APP
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
